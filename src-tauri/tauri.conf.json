{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CCBridge",
  "version": "0.8.3",
  "identifier": "dev.ccbridge.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CCBridge",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "resources": {
      "../dist/ccbridge-linux-x86_64": "ccbridge-linux-x86_64",
      "../LICENSE": "LICENSE",
      "../licenses/": "licenses/",
      "../ui/THIRD-PARTY.md": "UI-THIRD-PARTY.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1NDhCN0NGRTQzODg1QjMKUldTemhUamt6N2RJRlhwZ2t0bjFFSWlmTzU5QXpHZkhBRjVqZXRqdnNERldZMDZUSlk0WFdONTUK",
      "endpoints": [
        "https://github.com/akaryc1b/CCBridge/releases/latest/download/latest.json"
      ]
    }
  }
}
